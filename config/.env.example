# =============================================================================
# Paradise Studios - environment template
# =============================================================================
# Copy this file, fill it in, and store the COPY outside the web root.
#
#   copy config\.env.example  C:\xampp\paradisestudios.env
#
# The default location the application looks for is three levels above the
# project root, i.e. C:\xampp\paradisestudios.env, which is ABOVE htdocs and
# therefore unreachable over HTTP. Override it with the PS_ENV_FILE
# environment variable if you keep yours elsewhere.
#
# Every value below is a PLACEHOLDER. Do not commit a filled-in copy.
# Real environment variables override anything set in this file.
# =============================================================================


# --- Database ---------------------------------------------------------------
# Defaults shown are the existing XAMPP development values. Leaving this file
# absent entirely keeps the application working exactly as before.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=paradisestudios
DB_USER=root
DB_PASS=


# --- Payment gateway --------------------------------------------------------
# Which adapter to use: "mock" or "paystack".
#
# "mock" is a local simulator with no network access and no credentials. It is
# the correct setting for development and for the automated test suite.
# It does NOT move money and is refused outright when PAYMENT_LIVE=true.
PAYMENT_PROVIDER=mock

# Set to true ONLY when real money may move. While false, the Paystack adapter
# refuses to initialise a transaction and the mock provider refuses to be used
# in a live context. Guards against accidentally charging real cards.
PAYMENT_LIVE=false


# --- Paystack (only needed when PAYMENT_PROVIDER=paystack) ------------------
# Leave blank until you have created an account. The adapter fails with a clear
# configuration error while these are blank; it never fabricates credentials
# and never reports an unverified payment as successful.
#
# Test keys start with "sk_test_" / "pk_test_".
# Live keys start with "sk_live_" / "pk_live_".
#
# The secret key signs webhook HMACs. If it is empty, the webhook endpoint
# returns 503 rather than accepting unverified events.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Where Paystack should send the customer back to after paying.
# Must be an absolute URL on a domain you control.
PAYMENT_SUCCESS_URL=
PAYMENT_CANCEL_URL=

# Shared secret for signing the return query string (see api/payment-verify.php).
# Generate with: php -r "echo bin2hex(random_bytes(32));"


# --- Money and commission ---------------------------------------------------
# All amounts are held as integer minor units. For NGN that is kobo:
# NGN 15,000.00 is stored as 1500000.
CURRENCY=NGN

# Platform commission in basis points. 10000 = 100%, 1000 = 10%.
#
# Changing this affects NEW payments only. Every existing ledger entry stores
# the rate that was actually applied, so historical earnings are never
# recalculated with a new rate.
PLATFORM_COMMISSION_BPS=1000


# --- Refund policy ----------------------------------------------------------
# Mirrors the cancellation policy in api/cancel-booking.php: full refund at
# least FULL_REFUND_WINDOW_HOURS before the session starts, otherwise half.
#
# 10000 = 100%, 5000 = 50%.
FULL_REFUND_WINDOW_HOURS=24
FULL_REFUND_BPS=10000
LATE_REFUND_BPS=5000

# How long an initialised but unconfirmed payment holds a studio slot before it
# is treated as expired and stops blocking availability.
PAYMENT_EXPIRY_MINUTES=30


# --- Owner payouts ----------------------------------------------------------
# Hours after a session ENDS before the owner's earning becomes eligible.
# This is eligibility only - no transfer is ever initiated by this codebase.
PAYOUT_ELIGIBILITY_DELAY_HOURS=24

# Guard: owner earnings are never considered eligible while the booking is
# under dispute or administrative review.
BLOCK_PAYOUT_ON_DISPUTE=true

# =============================================================================
# TRANSACTIONAL EMAIL (Brevo)
# =============================================================================
# Registration sends a six-digit verification code. Delivery is handled by
# Brevo's transactional API over HTTPS via PHP cURL. See includes/mailer.php.
#
# Required for real delivery:
BREVO_API_KEY=                 # Brevo -> SMTP & API -> API Keys. Secret.
MAIL_FROM_ADDRESS=             # must be a SENDER VERIFIED address in Brevo
MAIL_FROM_NAME=Paradise Studios
#
# Optional. Override only for a regional endpoint or a local test double.
# Must be https:// or the mailer refuses to send.
BREVO_API_BASE=https://api.brevo.com
#
# ---------------------------------------------------------------------
# LOCAL DEVELOPMENT ONLY
# ---------------------------------------------------------------------
# Setting MAIL_DEV_FILE switches mail to a LOCAL FILE instead of Brevo. Nothing
# is sent over the network and nothing reaches an inbox.
#
# This is an explicit opt-in: when MAIL_DEV_FILE is set the dev sink is used,
# and when it is unset Brevo is used. There is NO fallback from Brevo to the
# file - if Brevo is misconfigured the send fails loudly.
#
# MUST be outside the web root. The file contains live verification codes and
# the mailer refuses any path under the document root.
# MAIL_DEV_FILE=C:/xampp/paradisestudios-mail/dev-mail.log
